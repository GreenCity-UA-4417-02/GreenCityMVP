<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="Huz6" author="YaroslavHuz">
        <createTable tableName="event_images_content">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="image_data" type="BLOB">
                <constraints nullable="false"/>
            </column>
            <column name="content_type" type="VARCHAR(255)"/>
        </createTable>

        <dropColumn tableName="events_images" columnName="data"/>

        <addColumn tableName="events_images">
            <column name="content_id" type="BIGINT">
                <constraints nullable="true" unique="true"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint baseTableName="events_images"
                                 baseColumnNames="content_id"
                                 constraintName="fk_events_images_content"
                                 referencedTableName="event_images_content"
                                 referencedColumnNames="id"/>

    </changeSet>
</databaseChangeLog>