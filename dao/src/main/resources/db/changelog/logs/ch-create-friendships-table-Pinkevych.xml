<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0" author="Sviatoslav P">
        <createTable tableName="friendships">
            <column name="user1_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user2_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                columnNames="user1_id, user2_id"
                constraintName="pk_friendships"
                tableName="friendships"/>

        <addForeignKeyConstraint
                baseTableName="friendships"
                baseColumnNames="user1_id"
                constraintName="fk_friendships_user1"
                referencedTableName="users"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="friendships"
                baseColumnNames="user2_id"
                constraintName="fk_friendships_user2"
                referencedTableName="users"
                referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>