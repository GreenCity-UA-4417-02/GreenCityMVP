        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="ch-add-column-notifications-Nadorozhnyi"
               author="sviat">

        <addColumn tableName="notifications">
