<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="Huz7" author="YaroslavHuz">
        <dropTable tableName="events_images" cascadeConstraints="true"/>
        <dropTable tableName="event_images_content" cascadeConstraints="true"/>

        <createTable tableName="event_images_content">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false" primaryKeyName="event_images_content_pkey"/>
            </column>
            <column name="image_data" type="BLOB">
                <constraints nullable="false"/>
            </column>
            <column name="content_type" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="events_images">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="events_images_pkey"/>
            </column>
            <column name="link" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="is_main" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="event_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="content_id" type="uuid">
                <constraints unique="true"
                             foreignKeyName="fk_events_images_content"
                             referencedTableName="event_images_content"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>